# Pinned versions for deploy/Dockerfile. Every value here is a build argument:
#   docker build -f deploy/Dockerfile $(grep -v '^#' deploy/versions.env | grep . | sed 's/^/--build-arg /') -t kata .
# Empty values are placeholders the owner must fill before the first build: the Dockerfile stops
# with an error when a value it needs is empty. Nothing is downloaded without a pinned hash.

# Base image: tag and manifest digest (sha256 of the tag, from `docker buildx imagetools inspect`).
PY_BASE_IMAGE=python:3.11-slim
PY_BASE_DIGEST=

# Service images (deploy/compose.yaml): tag, then manifest digest (sha256 of the tag, from
# `docker buildx imagetools inspect`). Empty digests are placeholders: compose stops until they are filled.
POSTGRES_IMAGE=postgres:17
POSTGRES_DIGEST=
CADDY_IMAGE=caddy:2.8-alpine
CADDY_DIGEST=

# gitleaks release (version and sha256 of the linux_x64 tarball, from the release checksums file).
GITLEAKS_VERSION=8.21.2
GITLEAKS_SHA256=

# Trainer tarball (dojo CLI, unpacked to /opt/trainer, run by the course.build job): release URL and sha256 of the tarball.
TRAINER_URL=
TRAINER_SHA256=

# Embedding model (retrieval.embedder = "model"): Hugging Face repo id and commit revision.
# Not baked into the image: the default embedder is "fake" (see config/kata.example.toml).
EMBED_MODEL_ID=
EMBED_MODEL_REVISION=
