# Resource profile for a larger VM (same variable names as small.env, larger values).
# Memory: 2048m + 4096m + 256m = 6400m. CPU: shares of the VM's cores (fractional allowed).
KATA_MEM_CORE=2048m
KATA_MEM_POSTGRES=4096m
KATA_MEM_PROXY=256m
KATA_CPU_CORE=2.0
KATA_CPU_POSTGRES=2.0
KATA_CPU_PROXY=0.5
