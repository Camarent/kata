# Resource profile for a 3 GB VM. Compose reads these names as ${...} substitutions.
# Memory limits must sum to under 2.5 GB (2560m) so the host OS and page cache keep the rest.
# Memory: 768m + 1024m + 128m = 1920m. CPU: shares of the VM's cores (fractional allowed).
KATA_MEM_CORE=768m
KATA_MEM_POSTGRES=1024m
KATA_MEM_PROXY=128m
KATA_CPU_CORE=1.0
KATA_CPU_POSTGRES=1.0
KATA_CPU_PROXY=0.25
