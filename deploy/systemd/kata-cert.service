[Unit]
Description=Renew the kata node certificate and reload caddy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Environment: the node name (set in /etc/kata/cert.env) and KATA_CERT_DIR (the host directory
# compose mounts read-only into the caddy service; default /var/lib/kata/certs).
EnvironmentFile=/etc/kata/cert.env
WorkingDirectory=/opt/kata/deploy
ExecStartPre=/bin/mkdir -p ${KATA_CERT_DIR}
ExecStart=/usr/bin/tailscale cert --cert-file ${KATA_CERT_DIR}/${KATA_TAILNET_NAME}.crt --key-file ${KATA_CERT_DIR}/${KATA_TAILNET_NAME}.key ${KATA_TAILNET_NAME}
ExecStart=/usr/bin/docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
