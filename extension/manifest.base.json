{
  "manifest_version": 3,
  "name": "kata",
  "version": "0.1.21",
  "permissions": ["storage", "activeTab", "scripting", "permissions"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ],
  "action": {}
}
